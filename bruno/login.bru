meta {
  name: 01 Login (captures token)
  type: http
  seq: 1
}

post {
  url: {{ASIND}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  // Stash the token in the environment so every other request uses {{token}}.
  if (res && res.body && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}
